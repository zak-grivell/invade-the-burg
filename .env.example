# Narration uses the hosted Heroku service; no local API key is required.
# The plugin does not load .env files. Export variables in the IDE process.
# Optional voice override (Settings > Tools > Reel Break takes precedence).
ELEVENLABS_VOICE_ID=
# Linux: supplied by your X11/XWayland session; do not export an empty override.
DISPLAY=
# Optional Wayland session variable, supplied by the desktop.
WAYLAND_DISPLAY=
# Set to x11 when launching under Wayland (with an available DISPLAY).
GDK_BACKEND=
